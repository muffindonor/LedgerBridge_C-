{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  },
  "Inbox": {
    "Path": "inbox",
    "ArchivePath": "archive",
    "RejectedPath": "rejected",
    "PollSeconds": 10
  },
  "Processor": {
    "GroupsPerChunk": 1000,
    "ChannelCapacity": 4
  }
}
